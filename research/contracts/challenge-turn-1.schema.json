  "properties": {
    "probe_choice": {"type": "string", "enum": ["P1", "P2", "P3"]},
    "positive_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "decision_relevance": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
